# EVChargeFlow Environment Variables Example
# Copy this file to .env and fill in your local values before running.

# Backend Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evchargeflow
DB_USER=root
DB_PASSWORD=your_mysql_password

# Frontend API Target (used by Vite)
VITE_API_BASE_URL=http://localhost:8080/api
